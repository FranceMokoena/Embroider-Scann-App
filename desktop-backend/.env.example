NODE_ENV=development
PORT=5011

# Required for /api/assets/* desktop read APIs.
DESKTOP_MONGO_URI=
JWT_SECRET=

# Existing mobile/backend API used by legacy archive adapters.
MOBILE_API_URL=https://embroider-scann-app.onrender.com/api

# Canonical RFID asset console rollout.
ASSET_UI_ENABLED=true
DESKTOP_LEGACY_MODE=read-only
DESKTOP_LEGACY_ALIAS_MODE=disabled
ASSET_API_CREATE_INDEXES=true

# Local development origins. Production should include the deployed desktop URL.
ALLOWED_ORIGINS=http://localhost:5011,http://localhost:3000,http://localhost:3001,http://localhost:19006
